{
  "name": "html-playground",
  "version": "1.0.0",
  "description": "Host live HTML/CSS/JS apps from your vault in a sandbox, with a validated bridge to your notes.",
  "author": "Anthirayas",
  "license": "MIT",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrayas/obsidian-html-playground.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
